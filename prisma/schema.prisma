generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      Role     @default(KASIR)
  createdAt DateTime @default(now()) @map("created_at")

  transaksis Transaksi[]

  @@map("users")
}

model Kategori {
  id        Int      @id @default(autoincrement())
  nama      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  produkts Produk[]

  @@map("kategori")
}

model Produk {
  id         Int      @id @default(autoincrement())
  nama       String   @db.VarChar(200)
  barcode    String?  @unique @db.VarChar(50)
  harga      Decimal  @db.Decimal(12, 2)
  stok       Int      @default(0)
  kategoriId Int      @map("kategori_id")
  gambar     String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  kategori         Kategori          @relation(fields: [kategoriId], references: [id])
  detailTransaksis DetailTransaksi[]

  @@map("produk")
}

model Transaksi {
  id            Int      @id @default(autoincrement())
  clientId      String?  @unique @map("client_id") @db.VarChar(36) // UUID from offline client
  userId        Int      @map("user_id")
  total         Decimal  @db.Decimal(12, 2)
  bayar         Decimal  @db.Decimal(12, 2)
  kembalian     Decimal  @db.Decimal(12, 2)
  metodeBayar   String   @default("TUNAI") @map("metode_bayar") @db.VarChar(20) // TUNAI, QRIS, DEBIT_KREDIT, TRANSFER
  paymentStatus String   @default("PAID") @map("payment_status") @db.VarChar(20) // PAID, PENDING, FAILED
  paymentRef    String?  @map("payment_ref") @db.VarChar(255) // gateway reference (Midtrans order_id)
  syncStatus    String   @default("synced") @map("sync_status") @db.VarChar(20) // synced, pending, failed
  createdAt     DateTime @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id])
  detailTransaksis DetailTransaksi[]

  @@map("transaksi")
}

model DetailTransaksi {
  id          Int     @id @default(autoincrement())
  transaksiId Int     @map("transaksi_id")
  produkId    Int     @map("produk_id")
  jumlah      Int
  subtotal    Decimal @db.Decimal(12, 2)

  transaksi Transaksi @relation(fields: [transaksiId], references: [id])
  produk    Produk    @relation(fields: [produkId], references: [id])

  @@map("detail_transaksi")
}

model Setting {
  id       Int    @id @default(autoincrement())
  namaToko String @default("Toko Saya") @map("nama_toko") @db.VarChar(200)
  alamat   String @default("") @map("alamat") @db.VarChar(500)
  noTelp   String @default("") @map("no_telp") @db.VarChar(20)
  footer   String @default("") @map("footer") @db.VarChar(500)

  @@map("setting")
}

enum Role {
  ADMIN
  KASIR
}
